<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration "installer": the installer for each architecture, as collected
  by the "sign-installers" job of the build workflow (built from the already signed app files).
  Each installer must say that it's Afterglow, in the version being released.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" default-value="0.0.0" />
  </parameters>
  <zip-file>
    <pe-file path="Afterglow-Installer.win-x64.exe" product-name="Afterglow" product-version="${version}">
      <authenticode-sign />
    </pe-file>
    <pe-file path="Afterglow-Installer.win-arm64.exe" product-name="Afterglow" product-version="${version}">
      <authenticode-sign />
    </pe-file>
    <pe-file path="Afterglow-Installer.win-x86.exe" product-name="Afterglow" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
