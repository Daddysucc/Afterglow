<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>../favicon.ico</ApplicationIcon>
    <!-- Shown by Windows (e.g. in Task Manager and the file's properties) -->
    <Product>Afterglow</Product>
    <AssemblyTitle>Afterglow</AssemblyTitle>
    <!-- Trimming is only supported for self-contained apps (which is how releases are published) -->
    <PublishTrimmed Condition="'$(SelfContained)' == 'true'">true</PublishTrimmed>
    <!-- Trimming removes the framework's precompiled code, so everything is compiled ahead of time
         again instead, rather than on every launch: this halves the CPU used to start (at the cost
         of larger files). It needs a target runtime, which releases are always published for. -->
    <PublishReadyToRun Condition="'$(SelfContained)' == 'true' and '$(RuntimeIdentifier)' != ''"
      >true</PublishReadyToRun>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <!-- A single-file executable must also contain the native libraries (Skia, HarfBuzz, ANGLE),
         otherwise it can't start once it's copied anywhere on its own -->
    <IncludeNativeLibrariesForSelfExtract Condition="'$(PublishSingleFile)' == 'true'"
      >true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <!-- Native dependencies ship their debug symbols (over 100 MB in total), which users don't need -->
  <Target Name="ExcludeNativeSymbolsFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish
        Remove="@(ResolvedFileToPublish)"
        Condition="'%(Extension)' == '.pdb'"
      />
    </ItemGroup>
  </Target>

  <PropertyGroup>
    <!-- Opt out of CET compatibility in the generated apphost to support older operating systems -->
    <CetCompat>false</CetCompat>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="../favicon.ico" Link="favicon.ico" />
    <AvaloniaResource Include="../favicon.png" Link="favicon.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Cogwheel" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="CSharpier.MsBuild" PrivateAssets="all" />
    <PackageReference Include="Deorcify" />
    <PackageReference Include="DialogHost.Avalonia" />
    <PackageReference Include="Markdig" />
    <PackageReference Include="Material.Avalonia" />
    <PackageReference Include="Material.Icons.Avalonia" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="PowerKit" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Afterglow.Core/Afterglow.Core.csproj" />
    <ProjectReference Include="../Afterglow.PlatformInterop/Afterglow.PlatformInterop.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Afterglow.Tests" />
  </ItemGroup>
</Project>
