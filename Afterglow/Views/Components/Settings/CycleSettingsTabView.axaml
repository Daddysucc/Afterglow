<UserControl
    x:Class="Afterglow.Views.Components.Settings.CycleSettingsTabView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    xmlns:converters="clr-namespace:Afterglow.Converters"
    xmlns:settings="clr-namespace:Afterglow.ViewModels.Components.Settings"
    x:DataType="settings:CycleSettingsTabViewModel"
>
    <StackPanel Orientation="Vertical" Spacing="12">
        <!--  Day  -->
        <Border Classes="card">
            <StackPanel Orientation="Vertical" Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Ellipse Width="9" Height="9" VerticalAlignment="Center" Fill="#5B9BD5" />
                    <TextBlock
                        Classes="card-title"
                        Text="{Binding LocalizationManager.DayStateLabel}"
                    />
                    <TextBlock
                        VerticalAlignment="Center"
                        Classes="card-subtitle"
                        Text="{Binding LocalizationManager.DayCardSubtitle}"
                    />
                </StackPanel>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="24">
                    <!--  Temperature  -->
                    <StackPanel
                        Grid.Column="0"
                        Orientation="Vertical"
                        Spacing="6"
                        ToolTip.Tip="{Binding LocalizationManager.DayTemperatureTooltip}"
                    >
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock
                                Classes="setting-label"
                                Text="{Binding LocalizationManager.TemperatureLabel}"
                            />
                            <TextBox
                                Grid.Column="1"
                                MinWidth="44"
                                Classes="value"
                                Text="{Binding DayTemperature, Converter={x:Static converters:DoubleToStringConverter.Instance}, UpdateSourceTrigger=LostFocus}"
                                Theme="{DynamicResource CompactTextBox}"
                            />
                        </Grid>
                        <Slider
                            IsSnapToTickEnabled="True"
                            LargeChange="500"
                            Maximum="{Binding RecommendedMaximumDayTemperature}"
                            Minimum="{Binding RecommendedMinimumDayTemperature}"
                            SmallChange="100"
                            TickFrequency="20"
                            Value="{Binding DayTemperature}"
                        />
                    </StackPanel>

                    <!--  Brightness  -->
                    <StackPanel Grid.Column="1" Orientation="Vertical" Spacing="6">
                        <ToolTip.Tip>
                            <TextBlock
                                MaxWidth="350"
                                Text="{Binding LocalizationManager.DayBrightnessTooltip}"
                                TextWrapping="Wrap"
                            />
                        </ToolTip.Tip>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock
                                Classes="setting-label"
                                Text="{Binding LocalizationManager.BrightnessLabel}"
                            />
                            <TextBox
                                Grid.Column="1"
                                MinWidth="44"
                                Classes="value"
                                Text="{Binding DayBrightness, Converter={x:Static converters:FractionToPercentageStringConverter.Instance}, UpdateSourceTrigger=LostFocus}"
                                Theme="{DynamicResource CompactTextBox}"
                            />
                        </Grid>
                        <Slider
                            IsSnapToTickEnabled="True"
                            LargeChange="0.1"
                            Maximum="1"
                            Minimum="0.1"
                            SmallChange="0.01"
                            TickFrequency="0.01"
                            Value="{Binding DayBrightness}"
                        />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!--  Evening  -->
        <Border Classes="card">
            <StackPanel Orientation="Vertical" Spacing="10">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse Width="9" Height="9" VerticalAlignment="Center" Fill="#F4B942" />
                        <TextBlock
                            Classes="card-title"
                            Text="{Binding LocalizationManager.EveningStateLabel}"
                        />
                        <TextBlock
                            VerticalAlignment="Center"
                            Classes="card-subtitle"
                            Text="{Binding LocalizationManager.EveningCardSubtitle}"
                        />
                    </StackPanel>
                    <ToggleSwitch
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        IsChecked="{Binding IsEveningConfigurationEnabled}"
                    >
                        <ToolTip.Tip>
                            <TextBlock
                                MaxWidth="350"
                                Text="{Binding LocalizationManager.EveningStageTooltip}"
                                TextWrapping="Wrap"
                            />
                        </ToolTip.Tip>
                    </ToggleSwitch>
                </Grid>

                <StackPanel
                    IsEnabled="{Binding IsEveningConfigurationEnabled}"
                    Orientation="Vertical"
                    Spacing="12"
                >
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="24">
                        <!--  Temperature  -->
                        <StackPanel
                            Grid.Column="0"
                            Orientation="Vertical"
                            Spacing="6"
                            ToolTip.Tip="{Binding LocalizationManager.EveningTemperatureTooltip}"
                        >
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock
                                    Classes="setting-label"
                                    Text="{Binding LocalizationManager.TemperatureLabel}"
                                />
                                <TextBox
                                    Grid.Column="1"
                                    MinWidth="44"
                                    Classes="value"
                                    Text="{Binding EveningTemperature, Converter={x:Static converters:DoubleToStringConverter.Instance}, UpdateSourceTrigger=LostFocus}"
                                    Theme="{DynamicResource CompactTextBox}"
                                />
                            </Grid>
                            <Slider
                                IsSnapToTickEnabled="True"
                                LargeChange="500"
                                Maximum="{Binding RecommendedMaximumEveningTemperature}"
                                Minimum="{Binding RecommendedMinimumEveningTemperature}"
                                SmallChange="100"
                                TickFrequency="20"
                                Value="{Binding EveningTemperature}"
                            />
                        </StackPanel>

                        <!--  Brightness  -->
                        <StackPanel Grid.Column="1" Orientation="Vertical" Spacing="6">
                            <ToolTip.Tip>
                                <TextBlock
                                    MaxWidth="350"
                                    Text="{Binding LocalizationManager.EveningBrightnessTooltip}"
                                    TextWrapping="Wrap"
                                />
                            </ToolTip.Tip>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock
                                    Classes="setting-label"
                                    Text="{Binding LocalizationManager.BrightnessLabel}"
                                />
                                <TextBox
                                    Grid.Column="1"
                                    MinWidth="44"
                                    Classes="value"
                                    Text="{Binding EveningBrightness, Converter={x:Static converters:FractionToPercentageStringConverter.Instance}, UpdateSourceTrigger=LostFocus}"
                                    Theme="{DynamicResource CompactTextBox}"
                                />
                            </Grid>
                            <Slider
                                IsSnapToTickEnabled="True"
                                LargeChange="0.1"
                                Maximum="1"
                                Minimum="0.1"
                                SmallChange="0.01"
                                TickFrequency="0.01"
                                Value="{Binding EveningBrightness}"
                            />
                        </StackPanel>
                    </Grid>

                    <!--  Bedtime (night start)  -->
                    <StackPanel Orientation="Vertical" Spacing="6">
                        <ToolTip.Tip>
                            <TextBlock
                                MaxWidth="350"
                                Text="{Binding LocalizationManager.NightStartTimeTooltip}"
                                TextWrapping="Wrap"
                            />
                        </ToolTip.Tip>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock
                                Classes="setting-label"
                                Text="{Binding LocalizationManager.BedtimeNightStartLabel}"
                            />
                            <TextBox
                                Grid.Column="1"
                                MinWidth="44"
                                Classes="value"
                                Text="{Binding NightStartTime, Converter={x:Static converters:TimeOnlyToStringConverter.Instance}, UpdateSourceTrigger=LostFocus}"
                                Theme="{DynamicResource CompactTextBox}"
                            />
                        </Grid>
                        <Slider
                            LargeChange="0.5"
                            Maximum="23.99999"
                            Minimum="0"
                            SmallChange="0.25"
                            Value="{Binding NightStartTime, Converter={x:Static converters:TimeOnlyToHoursDoubleConverter.Instance}}"
                        />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <!--  Night  -->
        <Border Classes="card">
            <StackPanel Orientation="Vertical" Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Ellipse Width="9" Height="9" VerticalAlignment="Center" Fill="#E85D3F" />
                    <TextBlock
                        Classes="card-title"
                        Text="{Binding LocalizationManager.NightStateLabel}"
                    />
                    <TextBlock
                        VerticalAlignment="Center"
                        Classes="card-subtitle"
                        Text="{Binding LocalizationManager.NightCardSubtitle}"
                    />
                </StackPanel>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="24">
                    <!--  Temperature  -->
                    <StackPanel
                        Grid.Column="0"
                        Orientation="Vertical"
                        Spacing="6"
                        ToolTip.Tip="{Binding LocalizationManager.NightTemperatureTooltip}"
                    >
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock
                                Classes="setting-label"
                                Text="{Binding LocalizationManager.TemperatureLabel}"
                            />
                            <TextBox
                                Grid.Column="1"
                                MinWidth="44"
                                Classes="value"
                                Text="{Binding NightTemperature, Converter={x:Static converters:DoubleToStringConverter.Instance}, UpdateSourceTrigger=LostFocus}"
                                Theme="{DynamicResource CompactTextBox}"
                            />
                        </Grid>
                        <Slider
                            IsSnapToTickEnabled="True"
                            LargeChange="500"
                            Maximum="{Binding RecommendedMaximumNightTemperature}"
                            Minimum="{Binding RecommendedMinimumNightTemperature}"
                            SmallChange="100"
                            TickFrequency="20"
                            Value="{Binding NightTemperature}"
                        />
                    </StackPanel>

                    <!--  Brightness  -->
                    <StackPanel Grid.Column="1" Orientation="Vertical" Spacing="6">
                        <ToolTip.Tip>
                            <TextBlock
                                MaxWidth="350"
                                Text="{Binding LocalizationManager.NightBrightnessTooltip}"
                                TextWrapping="Wrap"
                            />
                        </ToolTip.Tip>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock
                                Classes="setting-label"
                                Text="{Binding LocalizationManager.BrightnessLabel}"
                            />
                            <TextBox
                                Grid.Column="1"
                                MinWidth="44"
                                Classes="value"
                                Text="{Binding NightBrightness, Converter={x:Static converters:FractionToPercentageStringConverter.Instance}, UpdateSourceTrigger=LostFocus}"
                                Theme="{DynamicResource CompactTextBox}"
                            />
                        </Grid>
                        <Slider
                            IsSnapToTickEnabled="True"
                            LargeChange="0.1"
                            Maximum="1"
                            Minimum="0.1"
                            SmallChange="0.01"
                            TickFrequency="0.01"
                            Value="{Binding NightBrightness}"
                        />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!--  Transitions  -->
        <Border Classes="card">
            <StackPanel Orientation="Vertical" Spacing="10">
                <TextBlock
                    Classes="card-title"
                    Text="{Binding LocalizationManager.TransitionsCardTitle}"
                />

                <Grid ColumnDefinitions="*,*" ColumnSpacing="24">
                    <!--  Duration  -->
                    <StackPanel
                        Grid.Column="0"
                        Orientation="Vertical"
                        Spacing="6"
                        ToolTip.Tip="{Binding LocalizationManager.TransitionDurationTooltip}"
                    >
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock
                                Classes="setting-label"
                                Text="{Binding LocalizationManager.DurationLabel}"
                            />
                            <TextBox
                                Grid.Column="1"
                                MinWidth="44"
                                Classes="value"
                                Text="{Binding ConfigurationTransitionDuration, Converter={x:Static converters:TimeSpanToDurationStringConverter.Instance}, UpdateSourceTrigger=LostFocus}"
                                Theme="{DynamicResource CompactTextBox}"
                            />
                        </Grid>
                        <Slider
                            LargeChange="0.5"
                            Maximum="3"
                            Minimum="0"
                            SmallChange="0.08"
                            Value="{Binding ConfigurationTransitionDuration, Converter={x:Static converters:TimeSpanToHoursDoubleConverter.Instance}}"
                        />
                    </StackPanel>

                    <!--  Offset  -->
                    <StackPanel
                        Grid.Column="1"
                        Orientation="Vertical"
                        Spacing="6"
                        ToolTip.Tip="{Binding LocalizationManager.TransitionOffsetTooltip}"
                    >
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock
                                Classes="setting-label"
                                Text="{Binding LocalizationManager.TransitionOffsetShortLabel}"
                            />
                            <TextBox
                                Grid.Column="1"
                                MinWidth="44"
                                Classes="value"
                                Text="{Binding ConfigurationTransitionOffset, Converter={x:Static converters:FractionToPercentageStringConverter.Instance}, UpdateSourceTrigger=LostFocus}"
                                Theme="{DynamicResource CompactTextBox}"
                            />
                        </Grid>
                        <Slider
                            LargeChange="0.05"
                            Maximum="1"
                            Minimum="0"
                            SmallChange="0.01"
                            Value="{Binding ConfigurationTransitionOffset}"
                        />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!--  Grayscale  -->
        <Border Classes="card">
            <StackPanel Orientation="Vertical" Spacing="12">
                <StackPanel Orientation="Vertical" Spacing="2">
                    <TextBlock
                        Classes="card-title"
                        Text="{Binding LocalizationManager.GrayscaleCardTitle}"
                    />
                    <TextBlock
                        Classes="card-subtitle"
                        Text="{Binding LocalizationManager.GrayscaleCardSubtitle}"
                    />
                </StackPanel>

                <!--  Automatic schedule  -->
                <Grid
                    ColumnDefinitions="*,Auto"
                    ColumnSpacing="12"
                    ToolTip.Tip="{Binding LocalizationManager.GrayscaleScheduleTooltip}"
                >
                    <TextBlock
                        Classes="setting-label"
                        Text="{Binding LocalizationManager.GrayscaleScheduleLabel}"
                    />
                    <ComboBox
                        Grid.Column="1"
                        MinWidth="170"
                        SelectedIndex="{Binding GrayscaleScheduleIndex}"
                    >
                        <ComboBoxItem Content="{Binding LocalizationManager.GrayscaleScheduleOffOption}" />
                        <ComboBoxItem Content="{Binding LocalizationManager.GrayscaleScheduleNightOption}" />
                        <ComboBoxItem Content="{Binding LocalizationManager.GrayscaleScheduleEveningAndNightOption}" />
                        <ComboBoxItem Content="{Binding LocalizationManager.GrayscaleScheduleOnOption}" />
                    </ComboBox>
                </Grid>

                <!--  Color temperature in grayscale  -->
                <Grid
                    ColumnDefinitions="*,Auto"
                    ColumnSpacing="12"
                    ToolTip.Tip="{Binding LocalizationManager.GrayscaleTemperatureShiftTooltip}"
                >
                    <TextBlock
                        Classes="setting-label"
                        Text="{Binding LocalizationManager.GrayscaleTemperatureShiftLabel}"
                    />
                    <ToggleSwitch
                        Grid.Column="1"
                        IsChecked="{Binding IsGrayscaleTemperatureShiftEnabled}"
                    />
                </Grid>
            </StackPanel>
        </Border>

        <!--  Reset this tab's settings (at the very end, so that it isn't clicked by accident)  -->
        <Button
            Margin="0,4,0,0"
            Padding="10,6"
            HorizontalAlignment="Left"
            Command="{Binding ResetTabCommand}"
            Foreground="{DynamicResource TextMutedBrush}"
            Theme="{DynamicResource MaterialFlatButton}"
            ToolTip.Tip="{Binding LocalizationManager.ResetTooltip}"
        >
            <StackPanel Orientation="Horizontal" Spacing="6">
                <materialIcons:MaterialIcon Width="16" Height="16" Kind="Restore" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="12"
                    Text="{Binding ResetTabButtonText}"
                />
            </StackPanel>
        </Button>
    </StackPanel>
</UserControl>
