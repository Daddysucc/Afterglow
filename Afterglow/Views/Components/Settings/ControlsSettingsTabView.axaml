<UserControl
    x:Class="Afterglow.Views.Components.Settings.ControlsSettingsTabView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Afterglow.Views.Controls"
    xmlns:converters="clr-namespace:Afterglow.Converters"
    xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    xmlns:settings="clr-namespace:Afterglow.ViewModels.Components.Settings"
    x:DataType="settings:ControlsSettingsTabViewModel"
>
    <UserControl.Styles>
        <Style Selector="controls|HotKeyTextBox">
            <Setter Property="Width" Value="140" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <StackPanel Orientation="Vertical" Spacing="12">
        <!--  App  -->
        <Border Classes="card">
            <StackPanel Orientation="Vertical" Spacing="12">
                <TextBlock Classes="card-title" Text="{Binding LocalizationManager.AppCardTitle}" />

                <!--  Language  -->
                <Grid
                    ColumnDefinitions="*,Auto"
                    ToolTip.Tip="{Binding LocalizationManager.LanguageTooltip}"
                >
                    <TextBlock
                        Classes="setting-label"
                        Text="{Binding LocalizationManager.LanguageLabel}"
                    />
                    <ComboBox
                        Grid.Column="1"
                        MinWidth="140"
                        ItemsSource="{Binding AvailableLanguages}"
                        SelectedItem="{Binding Language}"
                    >
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={x:Static converters:LanguageToStringConverter.Instance}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>

                <!--  Start with Windows  -->
                <Grid
                    ColumnDefinitions="*,Auto"
                    ToolTip.Tip="{Binding LocalizationManager.StartWithWindowsTooltip}"
                >
                    <TextBlock
                        Classes="setting-label"
                        Text="{Binding LocalizationManager.StartWithWindowsLabel}"
                    />
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsAutoStartEnabled}" />
                </Grid>

                <!--  Start minimized  -->
                <Grid
                    ColumnDefinitions="*,Auto"
                    ToolTip.Tip="{Binding LocalizationManager.StartMinimizedTooltip}"
                >
                    <TextBlock
                        Classes="setting-label"
                        Text="{Binding LocalizationManager.StartMinimizedLabel}"
                    />
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsStartMinimizedEnabled}" />
                </Grid>

                <!--  Check for updates  -->
                <StackPanel Orientation="Vertical" Spacing="2">
                    <Grid
                        ColumnDefinitions="*,Auto,Auto"
                        ColumnSpacing="8"
                        ToolTip.Tip="{Binding LocalizationManager.CheckForUpdatesTooltip}"
                    >
                        <TextBlock
                            VerticalAlignment="Center"
                            Classes="setting-label"
                            Text="{Binding LocalizationManager.CheckForUpdatesLabel}"
                        />

                        <!--  Check now (also works while checking now and then is turned off)  -->
                        <Button
                            Grid.Column="1"
                            Padding="10,4"
                            VerticalAlignment="Center"
                            Command="{Binding CheckForUpdatesCommand}"
                            Foreground="{DynamicResource AccentTextBrush}"
                            Theme="{DynamicResource MaterialFlatButton}"
                            ToolTip.Tip="{Binding LocalizationManager.CheckForUpdatesNowTooltip}"
                        >
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon Width="16" Height="16" Kind="Refresh" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Text="{Binding LocalizationManager.CheckNowButton}"
                                />
                            </StackPanel>
                        </Button>

                        <!--  How often to check by itself (or never)  -->
                        <controls:TextComboBox
                            Grid.Column="2"
                            MinWidth="150"
                            VerticalAlignment="Center"
                            SelectedIndex="{Binding UpdateCheckFrequencyIndex}"
                        >
                            <ComboBoxItem Content="{Binding LocalizationManager.UpdateCheckNeverOption}" />
                            <ComboBoxItem Content="{Binding LocalizationManager.UpdateCheckDailyOption}" />
                            <ComboBoxItem Content="{Binding LocalizationManager.UpdateCheckWeeklyOption}" />
                            <ComboBoxItem Content="{Binding LocalizationManager.UpdateCheckEveryTwoWeeksOption}" />
                        </controls:TextComboBox>
                    </Grid>

                    <!--  The version that's running, and when updates were last checked for  -->
                    <TextBlock Classes="setting-hint" Text="{Binding VersionText}" />

                    <!--  Result of the last check (a link that installs the update, if there is one)  -->
                    <TextBlock Classes="setting-hint" Text="{Binding UpdateStatusText}">
                        <TextBlock.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding
                                    Converter="{x:Static ObjectConverters.IsNotNull}"
                                    Path="UpdateStatusText"
                                />
                                <Binding
                                    Converter="{x:Static BoolConverters.Not}"
                                    Path="IsUpdateStatusLink"
                                />
                            </MultiBinding>
                        </TextBlock.IsVisible>
                    </TextBlock>
                    <Button
                        Padding="0,2"
                        HorizontalAlignment="Left"
                        Command="{Binding InstallUpdateCommand}"
                        Cursor="Hand"
                        Foreground="{DynamicResource AccentTextBrush}"
                        IsVisible="{Binding IsUpdateStatusLink}"
                        Theme="{DynamicResource MaterialFlatButton}"
                    >
                        <TextBlock FontSize="11.5" Text="{Binding UpdateStatusText}" />
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <!--  Advanced  -->
        <Border Classes="card">
            <StackPanel Orientation="Vertical" Spacing="12">
                <TextBlock
                    Classes="card-title"
                    Text="{Binding LocalizationManager.AdvancedCardTitle}"
                />

                <!--  Extended gamma range  -->
                <Grid ColumnDefinitions="*,Auto">
                    <ToolTip.Tip>
                        <TextBlock
                            MaxWidth="350"
                            Text="{Binding LocalizationManager.ExtendedGammaRangeTooltip}"
                            TextWrapping="Wrap"
                        />
                    </ToolTip.Tip>
                    <TextBlock
                        Classes="setting-label"
                        Text="{Binding LocalizationManager.ExtendedGammaRangeLabel}"
                    />
                    <ToggleSwitch
                        Grid.Column="1"
                        IsChecked="{Binding IsExtendedGammaRangeUnlocked}"
                    />
                </Grid>

                <!--  Gamma polling  -->
                <StackPanel Orientation="Vertical" Spacing="6">
                    <Grid
                        ColumnDefinitions="*,Auto"
                        ToolTip.Tip="{Binding LocalizationManager.GammaPollingTooltip}"
                    >
                        <TextBlock
                            Classes="setting-label"
                            Text="{Binding LocalizationManager.GammaPollingLabel}"
                        />
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsGammaPollingEnabled}" />
                    </Grid>
                    <Grid
                        ColumnDefinitions="Auto,*,Auto"
                        ColumnSpacing="12"
                        IsEnabled="{Binding IsGammaPollingEnabled}"
                        ToolTip.Tip="{Binding LocalizationManager.GammaPollingIntervalTooltip}"
                    >
                        <TextBlock
                            Grid.Column="0"
                            Classes="setting-hint"
                            VerticalAlignment="Center"
                            Text="{Binding LocalizationManager.GammaPollingIntervalLabel}"
                        />
                        <Slider
                            Grid.Column="1"
                            IsSnapToTickEnabled="True"
                            LargeChange="1"
                            Maximum="10"
                            Minimum="0.5"
                            SmallChange="0.5"
                            TickFrequency="0.5"
                            Value="{Binding GammaPollingIntervalSeconds}"
                        />
                        <controls:ValueTextBox
                            Grid.Column="2"
                            MinWidth="40"
                            Classes="value"
                            Text="{Binding GammaPollingIntervalText, UpdateSourceTrigger=LostFocus}"
                            TextAlignment="Right"
                            Theme="{DynamicResource CompactTextBox}"
                        />
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Border>

        <!--  Global hotkeys  -->
        <Border Classes="card">
            <StackPanel Orientation="Vertical" Spacing="10">
                <StackPanel Orientation="Vertical" Spacing="2">
                    <TextBlock
                        Classes="card-title"
                        Text="{Binding LocalizationManager.HotkeysCardTitle}"
                    />
                    <TextBlock
                        Classes="card-subtitle"
                        Text="{Binding LocalizationManager.HotkeysCardSubtitle}"
                    />
                </StackPanel>

                <Grid
                    ColumnDefinitions="*,Auto"
                    ToolTip.Tip="{Binding LocalizationManager.ToggleAfterglowHotkeyTooltip}"
                >
                    <TextBlock
                        Classes="setting-label"
                        Text="{Binding LocalizationManager.ToggleAfterglowHotkeyLabel}"
                    />
                    <controls:HotKeyTextBox Grid.Column="1" HotKey="{Binding ToggleHotKey}" />
                </Grid>

                <Grid
                    ColumnDefinitions="*,Auto"
                    ToolTip.Tip="{Binding LocalizationManager.ToggleWindowHotkeyTooltip}"
                >
                    <TextBlock
                        Classes="setting-label"
                        Text="{Binding LocalizationManager.ToggleWindowLabel}"
                    />
                    <controls:HotKeyTextBox Grid.Column="1" HotKey="{Binding ToggleWindowHotKey}" />
                </Grid>

                <Grid
                    ColumnDefinitions="*,Auto"
                    ToolTip.Tip="{Binding LocalizationManager.IncreaseTemperatureOffsetTooltip}"
                >
                    <TextBlock
                        Classes="setting-label"
                        Text="{Binding LocalizationManager.IncreaseTemperatureOffsetLabel}"
                    />
                    <controls:HotKeyTextBox
                        Grid.Column="1"
                        HotKey="{Binding IncreaseTemperatureOffsetHotKey}"
                    />
                </Grid>

                <Grid
                    ColumnDefinitions="*,Auto"
                    ToolTip.Tip="{Binding LocalizationManager.DecreaseTemperatureOffsetTooltip}"
                >
                    <TextBlock
                        Classes="setting-label"
                        Text="{Binding LocalizationManager.DecreaseTemperatureOffsetLabel}"
                    />
                    <controls:HotKeyTextBox
                        Grid.Column="1"
                        HotKey="{Binding DecreaseTemperatureOffsetHotKey}"
                    />
                </Grid>

                <Grid
                    ColumnDefinitions="*,Auto"
                    ToolTip.Tip="{Binding LocalizationManager.IncreaseBrightnessOffsetTooltip}"
                >
                    <TextBlock
                        Classes="setting-label"
                        Text="{Binding LocalizationManager.IncreaseBrightnessOffsetLabel}"
                    />
                    <controls:HotKeyTextBox
                        Grid.Column="1"
                        HotKey="{Binding IncreaseBrightnessOffsetHotKey}"
                    />
                </Grid>

                <Grid
                    ColumnDefinitions="*,Auto"
                    ToolTip.Tip="{Binding LocalizationManager.DecreaseBrightnessOffsetTooltip}"
                >
                    <TextBlock
                        Classes="setting-label"
                        Text="{Binding LocalizationManager.DecreaseBrightnessOffsetLabel}"
                    />
                    <controls:HotKeyTextBox
                        Grid.Column="1"
                        HotKey="{Binding DecreaseBrightnessOffsetHotKey}"
                    />
                </Grid>

                <Grid
                    ColumnDefinitions="*,Auto"
                    ToolTip.Tip="{Binding LocalizationManager.ResetOffsetHotkeyTooltip}"
                >
                    <TextBlock
                        Classes="setting-label"
                        Text="{Binding LocalizationManager.ResetOffsetLabel}"
                    />
                    <controls:HotKeyTextBox
                        Grid.Column="1"
                        HotKey="{Binding ResetConfigurationOffsetHotKey}"
                    />
                </Grid>

                <Grid
                    ColumnDefinitions="*,Auto"
                    ToolTip.Tip="{Binding LocalizationManager.ToggleGrayscaleHotkeyTooltip}"
                >
                    <TextBlock
                        Classes="setting-label"
                        Text="{Binding LocalizationManager.ToggleGrayscaleHotkeyLabel}"
                    />
                    <controls:HotKeyTextBox
                        Grid.Column="1"
                        HotKey="{Binding ToggleGrayscaleHotKey}"
                    />
                </Grid>

                <Grid
                    ColumnDefinitions="*,Auto"
                    ToolTip.Tip="{Binding LocalizationManager.ToggleLightsPauseHotkeyTooltip}"
                >
                    <TextBlock
                        Classes="setting-label"
                        Text="{Binding LocalizationManager.ToggleLightsPauseHotkeyLabel}"
                    />
                    <controls:HotKeyTextBox
                        Grid.Column="1"
                        HotKey="{Binding ToggleLightsPauseHotKey}"
                    />
                </Grid>
            </StackPanel>
        </Border>

        <!--  Reset this tab's settings (at the very end, so that it isn't clicked by accident)  -->
        <Button
            Margin="0,4,0,0"
            Padding="10,6"
            HorizontalAlignment="Left"
            Command="{Binding ResetTabCommand}"
            Foreground="{DynamicResource TextMutedBrush}"
            Theme="{DynamicResource MaterialFlatButton}"
            ToolTip.Tip="{Binding LocalizationManager.ResetTooltip}"
        >
            <StackPanel Orientation="Horizontal" Spacing="6">
                <materialIcons:MaterialIcon Width="16" Height="16" Kind="Restore" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="12"
                    Text="{Binding ResetTabButtonText}"
                />
            </StackPanel>
        </Button>
    </StackPanel>
</UserControl>
