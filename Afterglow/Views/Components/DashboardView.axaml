<UserControl
    x:Class="Afterglow.Views.Components.DashboardView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="clr-namespace:Afterglow.ViewModels.Components"
    xmlns:controls="clr-namespace:Afterglow.Views.Controls"
    xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    xmlns:viewModels="clr-namespace:Afterglow.ViewModels"
    x:Name="UserControl"
    x:DataType="components:DashboardViewModel"
>
    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <!--  Color temperature of the current stage  -->
        <controls:TemperatureSlider
            Grid.Row="0"
            Margin="64,10,64,0"
            FontSize="14"
            Foreground="{DynamicResource TextPrimaryBrush}"
            Maximum="{Binding MaximumSliderTemperature}"
            Minimum="{Binding MinimumSliderTemperature}"
            ThumbBorderBrush="{DynamicResource AppHeaderBrush}"
            ToolTip.Tip="{Binding ActiveStageTemperatureTooltip}"
            TrackBrush="{DynamicResource AccentBrush}"
            Value="{Binding ActiveStageTemperature}"
        />

        <!--  Relative solar timing  -->
        <TextBlock
            Grid.Row="1"
            Margin="16,0,16,8"
            HorizontalAlignment="Center"
            FontSize="13"
            Foreground="{DynamicResource AccentTextBrush}"
            Text="{Binding SolarTimingText}"
            TextTrimming="CharacterEllipsis"
        />

        <!--  24-hour graph  -->
        <Border
            Grid.Row="2"
            Background="{DynamicResource GraphBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="0,1,0,0"
        >
            <Panel>
                <controls:CycleGraph
                    CurveBrush="{DynamicResource CurveBrush}"
                    Curve="{Binding CycleCurve}"
                    MarkerRingBrush="{DynamicResource GraphBrush}"
                    Now="{Binding DayProgress}"
                    ShadeOpacity="0.6"
                    WaveBrush="{DynamicResource WaveBrush}"
                />

                <!--  Active phase and current values  -->
                <TextBlock
                    Margin="12,0,12,13"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    FontSize="12"
                    Foreground="{DynamicResource TextMutedBrush}"
                    IsHitTestVisible="False"
                    Text="{Binding ActivePhaseCaption}"
                />

                <!--  Configuration offset (from hotkeys)  -->
                <StackPanel
                    x:Name="ConfigurationOffsetStackPanel"
                    Margin="0,0,12,12"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Background="Transparent"
                    Cursor="Hand"
                    IsVisible="{Binding IsOffsetEnabled}"
                    Orientation="Horizontal"
                    PointerReleased="ConfigurationOffsetStackPanel_OnPointerReleased"
                    Spacing="4"
                >
                    <ToolTip.Tip>
                        <TextBlock>
                            <Run Text="{Binding LocalizationManager.OffsetTooltipHeader}" />
                            <LineBreak />
                            <Run Text=" " />
                            <Run Text="{Binding LocalizationManager.TemperatureOffsetLabel}" />
                            <Run
                                FontWeight="SemiBold"
                                Text="{Binding TemperatureOffset, StringFormat={}{0:F0} K, Mode=OneWay}"
                            />
                            <LineBreak />
                            <Run Text=" " />
                            <Run Text="{Binding LocalizationManager.BrightnessOffsetLabel}" />
                            <Run
                                FontWeight="SemiBold"
                                Text="{Binding BrightnessOffset, StringFormat={}{0:P0}, Mode=OneWay}"
                            />
                            <LineBreak />
                            <LineBreak />
                            <Run
                                FontWeight="SemiBold"
                                Text="{Binding LocalizationManager.ClickToResetLabel}"
                            />
                        </TextBlock>
                    </ToolTip.Tip>
                    <materialIcons:MaterialIcon
                        Width="14"
                        Height="14"
                        Foreground="{DynamicResource TextMutedBrush}"
                        Kind="SwapVertical"
                    />
                    <TextBlock
                        FontSize="12"
                        Foreground="{DynamicResource TextMutedBrush}"
                        Text="{Binding LocalizationManager.OffsetLabel}"
                    />
                </StackPanel>
            </Panel>
        </Border>

        <!--  Footer  -->
        <Grid Grid.Row="3" Height="48" Margin="4,0,8,0" ColumnDefinitions="Auto,*,Auto">
            <!--  Cycle preview (content lines up with the graph caption)  -->
            <ToggleButton
                Grid.Column="0"
                Padding="8,4"
                VerticalAlignment="Center"
                Foreground="{DynamicResource TextMutedBrush}"
                IsChecked="{Binding IsCyclePreviewEnabled}"
                Theme="{DynamicResource MaterialFlatToggleButton}"
            >
                <ToggleButton.Styles>
                    <Style Selector="ToggleButton">
                        <Style Selector="^:checked">
                            <Setter
                                Property="ToolTip.Tip"
                                Value="{Binding LocalizationManager.StopPreviewTooltip}"
                            />
                            <Setter
                                Property="Foreground"
                                Value="{DynamicResource AccentTextBrush}"
                            />
                        </Style>
                        <Style Selector="^:unchecked">
                            <Setter
                                Property="ToolTip.Tip"
                                Value="{Binding LocalizationManager.StartPreviewTooltip}"
                            />
                        </Style>
                    </Style>
                </ToggleButton.Styles>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <materialIcons:MaterialIcon Width="18" Height="18">
                        <materialIcons:MaterialIcon.Styles>
                            <Style Selector="ToggleButton materialIcons|MaterialIcon">
                                <Setter Property="Kind" Value="PlayCircleOutline" />
                            </Style>
                            <Style Selector="ToggleButton:checked materialIcons|MaterialIcon">
                                <Setter Property="Kind" Value="StopCircleOutline" />
                            </Style>
                        </materialIcons:MaterialIcon.Styles>
                    </materialIcons:MaterialIcon>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        Text="{Binding LocalizationManager.PreviewText}"
                    />
                </StackPanel>
            </ToggleButton>

            <!--  Newer release on GitHub (opens its page)  -->
            <Button
                Grid.Column="1"
                Height="22"
                Margin="2,0,0,0"
                Padding="8,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Background="{DynamicResource AccentSoftBrush}"
                Command="{Binding InstallUpdateCommand}"
                CornerRadius="11"
                Foreground="{DynamicResource AccentTextBrush}"
                IsVisible="{Binding IsUpdateAvailable}"
                Theme="{DynamicResource MaterialFlatButton}"
                ToolTip.Tip="{Binding UpdateAvailableTooltip}"
            >
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <materialIcons:MaterialIcon Width="13" Height="13" Kind="ArrowUpCircle" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="11"
                        Text="{Binding UpdateButtonText}"
                    />
                </StackPanel>
            </Button>

            <!--  Location (opens location settings)  -->
            <Button
                Grid.Column="2"
                Padding="8,4"
                VerticalAlignment="Center"
                Command="{Binding $parent[Window].((viewModels:MainViewModel)DataContext).ShowLocationSettingsCommand}"
                Foreground="{DynamicResource TextPrimaryBrush}"
                Theme="{DynamicResource MaterialFlatButton}"
                ToolTip.Tip="{Binding LocalizationManager.OpenLocationSettingsTooltip}"
            >
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <materialIcons:MaterialIcon
                        Width="16"
                        Height="16"
                        Foreground="{DynamicResource AccentTextBrush}"
                        Kind="NavigationVariant"
                    />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="Normal"
                        Text="{Binding LocationText}"
                    />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</UserControl>
