<UserControl
    x:Class="LightBulb.Views.Components.DashboardView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="clr-namespace:LightBulb.ViewModels.Components"
    xmlns:controls="clr-namespace:LightBulb.Views.Controls"
    xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    xmlns:viewModels="clr-namespace:LightBulb.ViewModels"
    x:Name="UserControl"
    x:DataType="components:DashboardViewModel"
>
    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <!--  Color temperature of the current stage  -->
        <controls:TemperatureSlider
            Grid.Row="0"
            Margin="64,10,64,0"
            FontSize="14"
            Foreground="{DynamicResource DashboardTextBrush}"
            Maximum="{Binding MaximumSliderTemperature}"
            Minimum="{Binding MinimumSliderTemperature}"
            ThumbBorderBrush="{DynamicResource DashboardSliderThumbBorderBrush}"
            ToolTip.Tip="{Binding ActiveStageTemperatureTooltip}"
            TrackBrush="{DynamicResource DashboardSliderTrackBrush}"
            Value="{Binding ActiveStageTemperature}"
        />

        <!--  Relative solar timing  -->
        <TextBlock
            Grid.Row="1"
            Margin="16,0,16,8"
            HorizontalAlignment="Center"
            FontSize="13"
            Foreground="{DynamicResource DashboardMutedTextBrush}"
            Text="{Binding SolarTimingText}"
            TextTrimming="CharacterEllipsis"
        />

        <!--  24-hour graph  -->
        <Border
            Grid.Row="2"
            Background="{DynamicResource DashboardGraphBrush}"
            BorderBrush="{DynamicResource DashboardGraphBorderBrush}"
            BorderThickness="0,1,0,0"
        >
            <Panel>
                <controls:CycleGraph
                    CurveBrush="{DynamicResource DashboardCurveBrush}"
                    Curve="{Binding CycleCurve}"
                    MarkerRingBrush="{DynamicResource DashboardMarkerRingBrush}"
                    Now="{Binding DayProgress}"
                    ShadeOpacity="{DynamicResource DashboardShadeOpacity}"
                    WaveBrush="{DynamicResource DashboardWaveBrush}"
                />

                <!--  Active phase and current values  -->
                <TextBlock
                    Margin="12,0,12,13"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    FontSize="12"
                    Foreground="{DynamicResource DashboardCaptionBrush}"
                    IsHitTestVisible="False"
                    Text="{Binding ActivePhaseCaption}"
                />

                <!--  Configuration offset (from hotkeys)  -->
                <StackPanel
                    x:Name="ConfigurationOffsetStackPanel"
                    Margin="0,0,12,12"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Background="Transparent"
                    Cursor="Hand"
                    IsVisible="{Binding IsOffsetEnabled}"
                    Orientation="Horizontal"
                    PointerReleased="ConfigurationOffsetStackPanel_OnPointerReleased"
                    Spacing="4"
                >
                    <ToolTip.Tip>
                        <TextBlock>
                            <Run Text="{Binding LocalizationManager.OffsetTooltipHeader}" />
                            <LineBreak />
                            <Run Text=" " />
                            <Run Text="{Binding LocalizationManager.TemperatureOffsetLabel}" />
                            <Run
                                FontWeight="SemiBold"
                                Text="{Binding TemperatureOffset, StringFormat={}{0:F0} K, Mode=OneWay}"
                            />
                            <LineBreak />
                            <Run Text=" " />
                            <Run Text="{Binding LocalizationManager.BrightnessOffsetLabel}" />
                            <Run
                                FontWeight="SemiBold"
                                Text="{Binding BrightnessOffset, StringFormat={}{0:P0}, Mode=OneWay}"
                            />
                            <LineBreak />
                            <LineBreak />
                            <Run
                                FontWeight="SemiBold"
                                Text="{Binding LocalizationManager.ClickToResetLabel}"
                            />
                        </TextBlock>
                    </ToolTip.Tip>
                    <materialIcons:MaterialIcon
                        Width="14"
                        Height="14"
                        Foreground="{DynamicResource DashboardCaptionBrush}"
                        Kind="SwapVertical"
                    />
                    <TextBlock
                        FontSize="12"
                        Foreground="{DynamicResource DashboardCaptionBrush}"
                        Text="{Binding LocalizationManager.OffsetLabel}"
                    />
                </StackPanel>
            </Panel>
        </Border>

        <!--  Footer  -->
        <Grid Grid.Row="3" Height="52" Margin="16,0,8,0" ColumnDefinitions="Auto,Auto,*,Auto">
            <!--  Bedtime (night start)  -->
            <StackPanel
                Grid.Column="0"
                VerticalAlignment="Center"
                IsEnabled="{Binding IsEveningConfigurationEnabled}"
                Orientation="Horizontal"
                Spacing="6"
                ToolTip.ShowOnDisabled="True"
                ToolTip.Tip="{Binding LocalizationManager.BedtimeTooltip}"
            >
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="24"
                    Foreground="{DynamicResource DashboardBedtimeBrush}"
                    Text="{Binding NightStartTimeText}"
                />
                <StackPanel VerticalAlignment="Center" Orientation="Vertical">
                    <Button
                        Width="22"
                        Height="16"
                        Padding="0"
                        Command="{Binding IncreaseNightStartTimeCommand}"
                        Foreground="{DynamicResource DashboardBedtimeBrush}"
                        Theme="{DynamicResource MaterialFlatButton}"
                        ToolTip.Tip="{Binding LocalizationManager.LaterBedtimeTooltip}"
                    >
                        <materialIcons:MaterialIcon Width="18" Height="18" Kind="ChevronUp" />
                    </Button>
                    <Button
                        Width="22"
                        Height="16"
                        Padding="0"
                        Command="{Binding DecreaseNightStartTimeCommand}"
                        Foreground="{DynamicResource DashboardBedtimeBrush}"
                        Theme="{DynamicResource MaterialFlatButton}"
                        ToolTip.Tip="{Binding LocalizationManager.EarlierBedtimeTooltip}"
                    >
                        <materialIcons:MaterialIcon Width="18" Height="18" Kind="ChevronDown" />
                    </Button>
                </StackPanel>
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="14"
                    Foreground="{DynamicResource DashboardTextBrush}"
                    Text="{Binding LocalizationManager.BedtimeSuffixText}"
                />
            </StackPanel>

            <!--  Cycle preview  -->
            <ToggleButton
                Grid.Column="1"
                Margin="16,0,0,0"
                Padding="8,4"
                VerticalAlignment="Center"
                Foreground="{DynamicResource DashboardCaptionBrush}"
                IsChecked="{Binding IsCyclePreviewEnabled}"
                Theme="{DynamicResource MaterialFlatToggleButton}"
            >
                <ToggleButton.Styles>
                    <Style Selector="ToggleButton">
                        <Style Selector="^:checked">
                            <Setter
                                Property="ToolTip.Tip"
                                Value="{Binding LocalizationManager.StopPreviewTooltip}"
                            />
                        </Style>
                        <Style Selector="^:unchecked">
                            <Setter
                                Property="ToolTip.Tip"
                                Value="{Binding LocalizationManager.StartPreviewTooltip}"
                            />
                        </Style>
                    </Style>
                </ToggleButton.Styles>
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <materialIcons:MaterialIcon Width="18" Height="18">
                        <materialIcons:MaterialIcon.Styles>
                            <Style Selector="ToggleButton materialIcons|MaterialIcon">
                                <Setter Property="Kind" Value="PlayCircleOutline" />
                            </Style>
                            <Style Selector="ToggleButton:checked materialIcons|MaterialIcon">
                                <Setter Property="Kind" Value="StopCircleOutline" />
                            </Style>
                        </materialIcons:MaterialIcon.Styles>
                    </materialIcons:MaterialIcon>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        Text="{Binding LocalizationManager.PreviewText}"
                    />
                </StackPanel>
            </ToggleButton>

            <!--  Location (opens location settings)  -->
            <Button
                Grid.Column="3"
                Padding="8,4"
                VerticalAlignment="Center"
                Command="{Binding $parent[Window].((viewModels:MainViewModel)DataContext).ShowLocationSettingsCommand}"
                Foreground="{DynamicResource DashboardTextBrush}"
                Theme="{DynamicResource MaterialFlatButton}"
                ToolTip.Tip="{Binding LocalizationManager.OpenLocationSettingsTooltip}"
            >
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <materialIcons:MaterialIcon
                        Width="16"
                        Height="16"
                        Foreground="{DynamicResource DashboardMutedTextBrush}"
                        Kind="NavigationVariant"
                    />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="Normal"
                        Text="{Binding LocationText}"
                    />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</UserControl>
