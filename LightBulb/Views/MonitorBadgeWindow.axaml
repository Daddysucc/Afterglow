<Window
    x:Class="LightBulb.Views.MonitorBadgeWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lightBulb="clr-namespace:LightBulb"
    Title="{x:Static lightBulb:Program.DisplayName}"
    Background="Transparent"
    CanResize="False"
    IsHitTestVisible="False"
    ShowActivated="False"
    ShowInTaskbar="False"
    SizeToContent="WidthAndHeight"
    Topmost="True"
    TransparencyLevelHint="Transparent"
    WindowDecorations="None"
    WindowStartupLocation="Manual"
>
    <Border
        Padding="18,12"
        Background="{DynamicResource TrayMenuBrush}"
        BorderBrush="{DynamicResource AccentBrush}"
        BorderThickness="2"
        CornerRadius="12"
    >
        <StackPanel Orientation="Horizontal" Spacing="14">
            <TextBlock
                x:Name="NumberTextBlock"
                VerticalAlignment="Center"
                FontSize="44"
                FontWeight="Bold"
                Foreground="{DynamicResource AccentTextBrush}"
            />
            <StackPanel VerticalAlignment="Center" Orientation="Vertical" Spacing="2">
                <TextBlock
                    x:Name="NameTextBlock"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                />
                <TextBlock
                    x:Name="DetailsTextBlock"
                    FontSize="12"
                    Foreground="{DynamicResource TextMutedBrush}"
                />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
